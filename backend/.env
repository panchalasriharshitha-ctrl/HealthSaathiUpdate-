# Server Settings
APP_NAME=MediMate AI Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8001

# Database
DATABASE_URL=sqlite:///./medimate.db

# Frontend CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Model Provider (Do not hardcode keys here! Paste your private key only in .env)
AI_PROVIDER=openai
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
