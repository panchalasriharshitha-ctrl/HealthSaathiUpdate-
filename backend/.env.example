# ==============================================================================
# HealthSaathi AI - Backend Environment Template (.env)
# Copy this file to .env and configure your secrets (Never commit secrets to git!)
# ==============================================================================

# Server Settings
APP_NAME=HealthSaathi AI Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8001

# SQLite Database
DATABASE_URL=sqlite:///./healthsaathi.db

# Frontend CORS (Allow local Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Gemini API (Server-side only; never expose to frontend)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase Server Credentials
