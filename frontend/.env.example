# ==============================================================================
# HealthSaathi AI - Frontend Environment Template (.env)
# Copy this file to .env in the frontend directory
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8001/api

# Supabase Auth & Storage (Client-side publishable key only)
# Obtain your free Supabase credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
